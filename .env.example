# V1 runs ONLY as a local demonstration. No live payments.
STORE_MODE=demo
DATA_DIR=.data
# Optional canonical URL (keep localhost for local development)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Optional confirmed public WhatsApp number, digits only including country code
NEXT_PUBLIC_WHATSAPP_NUMBER=
# Generate with npm run admin:password. Never use a plaintext password here.
ADMIN_PASSWORD_HASH=
OPERATOR_PASSWORD_HASH=
SESSION_SECRET=
# Production integration requirements; not used by the local demo adapter.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
